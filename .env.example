APP_ENVIRONMENT=development
APP_DATABASE_URL=sqlite:///./rag_notes_agent.db
# Docker Compose 数据库角色；POSTGRES_USER 仅用于初始化，应用连接使用 POSTGRES_APP_USER。
POSTGRES_USER=rag_notes
POSTGRES_PASSWORD=rag_notes_dev_password
POSTGRES_APP_USER=rag_notes_app
POSTGRES_APP_PASSWORD=rag_notes_app_dev_password
# 备份维护容器将归档写入宿主机 ./backups（已被 Git 忽略）；恢复只允许新建演练库。
# BACKUP_FILE=rag-notes-20260812T000000Z.dump
# RESTORE_DATABASE=rag_notes_restore_20260812
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173
APP_INGESTION_DISPATCH_MODE=background
# 入库 Worker 租约与指数退避：超过最大次数进入 dead_letter，需人工重放。
APP_INGESTION_MAX_ATTEMPTS=3
APP_INGESTION_LEASE_SECONDS=900
APP_INGESTION_RETRY_BASE_SECONDS=5
APP_INGESTION_RETRY_MAX_SECONDS=300
APP_WEB_IMPORT_TIMEOUT_SECONDS=15
APP_WEB_IMPORT_MAX_BYTES=5242880
APP_WEB_IMPORT_MAX_REDIRECTS=3
APP_WEB_IMPORT_ALLOW_HTTP=false
# 网页来源在入库后异步复核。空白白名单代表“仅记录可用性，不将任何外部域名标记为受信任”。
APP_SOURCE_VALIDATION_ENABLED=true
APP_SOURCE_VALIDATION_TIMEOUT_SECONDS=10
APP_SOURCE_VALIDATION_APPROVED_DOMAINS=docs.example.com,help.example.com
APP_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
APP_DEFAULT_WORKSPACE_NAME=默认工作区
# 生产内部服务可开启；格式：workspace_id=api_key,workspace_id_2=api_key_2
APP_AUTH_ENABLED=false
APP_WORKSPACE_API_KEYS=
# 生产审批角色映射：workspace_id:actor_id=owner,workspace_id:actor_id=approver
APP_WORKSPACE_ACTOR_ROLES=
# evidence_synthesis 适合本地演示；openai_compatible 使用 Chat Completions 流式接口。
APP_LLM_PROVIDER=evidence_synthesis
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_MODEL=
APP_LLM_API_KEY=
APP_MODEL_MAX_CONCURRENCY=4
APP_MODEL_ACQUIRE_TIMEOUT_SECONDS=3
APP_MODEL_RETRY_ATTEMPTS=2
APP_MODEL_RETRY_BASE_SECONDS=0.5
APP_MODEL_RETRY_MAX_SECONDS=8
APP_LLM_MAX_OUTPUT_TOKENS=1024
# Hashing 仅验证本地索引流程；生产必须使用真实语义 Embedding 与 PostgreSQL/pgvector。
APP_EMBEDDING_PROVIDER=hashing
APP_EMBEDDING_BASE_URL=https://api.openai.com/v1
APP_EMBEDDING_MODEL=hashing-256
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_DIMENSIONS=256
# 单次 Embedding 请求中的切块数量。DashScope 等 OpenAI 兼容网关通常限制为 25。
APP_EMBEDDING_BATCH_SIZE=25
APP_RETRIEVAL_MODE=hybrid
# 智能路由只处理规则灰区，低置信度时安全回退 RAG。
APP_QUERY_ROUTER_ENABLED=false
APP_QUERY_ROUTER_TIMEOUT_SECONDS=4
APP_QUERY_ROUTER_CONFIDENCE_THRESHOLD=0.85
# Rewrite 复用问答模型。未配置真实 LLM 或调用失败时自动使用原问题检索。
APP_QUERY_REWRITE_ENABLED=false
APP_QUERY_REWRITE_MULTI_QUERY_ENABLED=true
APP_QUERY_REWRITE_MAX_VARIANTS=5
APP_QUERY_REWRITE_MAX_SUBQUERIES=3
APP_QUERY_REWRITE_MAX_SYNONYMS=3
APP_QUERY_REWRITE_TIMEOUT_SECONDS=12
APP_QUERY_REWRITE_MAX_LENGTH=256
# Parent-Child 上下文扩展和元数据加权均受长度/增益上限控制。
APP_PARENT_CHILD_ENABLED=true
APP_PARENT_CHILD_WINDOW=1
APP_PARENT_CHILD_MAX_CHARACTERS=2400
# 发送给模型的证据上下文预算；超限只截断生成副本，引用快照仍保留原始内容。
APP_RAG_CONTEXT_MAX_TOKENS=4096
# 重排后自适应缩减最终证据数：先保证最小证据与来源覆盖，再按分数断崖和预算停止；关闭后退回请求的固定 K。
APP_DYNAMIC_TOP_K_ENABLED=true
APP_DYNAMIC_TOP_K_MIN_CANDIDATES=3
APP_DYNAMIC_TOP_K_MAX_CANDIDATES=12
APP_DYNAMIC_TOP_K_SCORE_GAP_THRESHOLD=0.12
APP_DYNAMIC_TOP_K_TARGET_SOURCE_COVERAGE=2
APP_DYNAMIC_TOP_K_BUDGET_RATIO=0.8
# Bounded Agentic RAG 仅允许关系/全局问题作受限多步检索；超预算后必须停止。
APP_AGENTIC_RAG_ENABLED=true
APP_AGENTIC_RAG_MAX_STEPS=3
APP_AGENTIC_RAG_MIN_EVIDENCE=3
APP_AGENTIC_RAG_TOKEN_BUDGET=6000
APP_AGENTIC_RAG_MAX_LATENCY_MS=12000
# 定向实体倒排 + 通用 Hybrid 双路召回；实体路径为空时仍保留通用召回结果。
APP_ENTITY_RETRIEVAL_ENABLED=true
APP_ENTITY_RETRIEVAL_MAX_ENTITIES=12
APP_ENTITY_RETRIEVAL_CANDIDATE_LIMIT=30
# 受控标签仅在人工审批后进入定向召回；默认关闭，先完成离线评测再启用。
APP_TAG_RETRIEVAL_ENABLED=false
APP_TAG_RETRIEVAL_MAX_TAGS=12
APP_TAG_RETRIEVAL_CANDIDATE_LIMIT=30
# 图谱 LLM 抽取默认关闭；显式开启并配置 openai_compatible LLM 后才会调用模型。
APP_GRAPH_LLM_EXTRACTION_ENABLED=false
APP_GRAPH_LLM_EXTRACTION_TIMEOUT_SECONDS=20
APP_GRAPH_LLM_EXTRACTION_MAX_CHARS=6000
APP_METADATA_BOOST_ENABLED=true
APP_METADATA_TITLE_BOOST=0.12
APP_METADATA_SECTION_BOOST=0.08
APP_METADATA_SOURCE_TYPE_BOOST=0.03
APP_METADATA_MAX_BOOST=0.20
APP_RERANKER_ENABLED=false
# rule 为本地确定性回退；dashscope_compatible 使用 /reranks Cross-encoder 接口。
APP_RERANKER_PROVIDER=rule
APP_RERANKER_MODEL=
APP_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
APP_RERANKER_API_KEY=
APP_RERANKER_CANDIDATE_LIMIT=20
APP_RERANKER_TIMEOUT_SECONDS=20
# Redis 仅保存缓存数据。生产环境请使用 TLS、ACL 和独立逻辑数据库；空值时自动使用进程内 TTL LRU。
APP_CACHE_ENABLED=true
APP_REDIS_URL=
APP_REDIS_KEY_PREFIX=rag-notes-agent
APP_CACHE_DEFAULT_TTL_SECONDS=900
APP_CACHE_LOCAL_MAX_ENTRIES=512
# 固定窗口限流按工作区（已认证）或匿名 IP 分桶，Redis 不可用时自动使用进程内回退。
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_API_REQUESTS=1000
APP_RATE_LIMIT_WRITE_REQUESTS=240
APP_RATE_LIMIT_EXPENSIVE_REQUESTS=60
APP_RATE_LIMIT_AGENT_REQUESTS=30
# Prometheus 指标默认关闭；生产建议通过内网抓取并配置独立的指标令牌。
APP_METRICS_ENABLED=false
APP_METRICS_TOKEN=
# OpenTelemetry 默认为关闭。启用后需要同时启动 observability profile；Trace 只记录路由模板、耗时、计数和错误类型。
APP_TELEMETRY_ENABLED=false
APP_TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
APP_TELEMETRY_SERVICE_NAME=rag-notes-agent
APP_TELEMETRY_SAMPLE_RATIO=1.0
APP_ALLOW_LOCAL_DEVELOPMENT_PROVIDERS=true
# 是否允许工作区成员在设置页选择模型 Provider。生产环境应结合工作区权限控制启用。
APP_ALLOW_USER_MODEL_CONFIGURATION=true
# 使用 Fernet.generate_key() 生成并仅保存在部署环境中；不要提交实际密钥。
# Docker Compose 本地验收栈提供了开发默认值，生产环境必须覆盖此项。
APP_CONFIGURATION_ENCRYPTION_KEY=
